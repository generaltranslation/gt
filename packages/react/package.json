{
  "name": "gt-react",
  "version": "12.0.0-samsara.0",
  "description": "A React library for automatic internationalization.",
  "main": "./dist/index.server.cjs",
  "module": "./dist/index.server.mjs",
  "types": "./dist/index.types.d.cts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/macros.*"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "generaltranslation": "workspace:*",
    "@generaltranslation/react-core": "workspace:*",
    "gt-i18n": "workspace:*",
    "@generaltranslation/format": "workspace:*"
  },
  "scripts": {
    "patch": "pnpm version patch",
    "transpile": "tsdown",
    "build": "tsdown",
    "build:clean": "sh ../../scripts/clean.sh && pnpm run build",
    "build:release": "pnpm run build:clean",
    "release": "pnpm run build:clean && pnpm publish",
    "release:alpha": "pnpm run build:clean && pnpm publish --tag alpha",
    "release:beta": "pnpm run build:clean && pnpm publish --tag beta",
    "release:latest": "pnpm run build:clean && pnpm publish --tag latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generaltranslation/gt.git"
  },
  "author": "General Translation, Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/generaltranslation/gt/issues"
  },
  "homepage": "https://generaltranslation.com/",
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": ">=18.0.0 <20.0.0",
    "@types/react-dom": ">=18.0.0 <20.0.0",
    "jsdom": "^26.1.0",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "react-server": {
        "require": {
          "types": "./dist/index.rsc.d.cts",
          "default": "./dist/index.rsc.cjs"
        },
        "import": {
          "types": "./dist/index.rsc.d.mts",
          "default": "./dist/index.rsc.mjs"
        },
        "default": "./dist/index.rsc.mjs"
      },
      "workerd": {
        "require": {
          "types": "./dist/index.types.d.cts",
          "default": "./dist/index.server.cjs"
        },
        "import": {
          "types": "./dist/index.types.d.mts",
          "default": "./dist/index.server.mjs"
        },
        "default": "./dist/index.server.mjs"
      },
      "worker": {
        "require": {
          "types": "./dist/index.types.d.cts",
          "default": "./dist/index.server.cjs"
        },
        "import": {
          "types": "./dist/index.types.d.mts",
          "default": "./dist/index.server.mjs"
        },
        "default": "./dist/index.server.mjs"
      },
      "browser": {
        "require": {
          "types": "./dist/index.types.d.cts",
          "default": "./dist/index.client.cjs"
        },
        "import": {
          "types": "./dist/index.types.d.mts",
          "default": "./dist/index.client.mjs"
        },
        "default": "./dist/index.client.mjs"
      },
      "require": {
        "types": "./dist/index.types.d.cts",
        "default": "./dist/index.server.cjs"
      },
      "import": {
        "types": "./dist/index.types.d.mts",
        "default": "./dist/index.server.mjs"
      },
      "default": "./dist/index.server.mjs"
    },
    "./compat": {
      "react-server": {
        "require": {
          "types": "./dist/compat.rsc.d.cts",
          "default": "./dist/compat.rsc.cjs"
        },
        "import": {
          "types": "./dist/compat.rsc.d.mts",
          "default": "./dist/compat.rsc.mjs"
        },
        "default": "./dist/compat.rsc.mjs"
      },
      "workerd": {
        "require": {
          "types": "./dist/compat.server.d.cts",
          "default": "./dist/compat.server.cjs"
        },
        "import": {
          "types": "./dist/compat.server.d.mts",
          "default": "./dist/compat.server.mjs"
        },
        "default": "./dist/compat.server.mjs"
      },
      "worker": {
        "require": {
          "types": "./dist/compat.server.d.cts",
          "default": "./dist/compat.server.cjs"
        },
        "import": {
          "types": "./dist/compat.server.d.mts",
          "default": "./dist/compat.server.mjs"
        },
        "default": "./dist/compat.server.mjs"
      },
      "browser": {
        "require": {
          "types": "./dist/compat.client.d.cts",
          "default": "./dist/compat.client.cjs"
        },
        "import": {
          "types": "./dist/compat.client.d.mts",
          "default": "./dist/compat.client.mjs"
        },
        "default": "./dist/compat.client.mjs"
      },
      "require": {
        "types": "./dist/compat.server.d.cts",
        "default": "./dist/compat.server.cjs"
      },
      "import": {
        "types": "./dist/compat.server.d.mts",
        "default": "./dist/compat.server.mjs"
      },
      "default": "./dist/compat.server.mjs"
    },
    "./macros": {
      "require": {
        "types": "./dist/macros.d.cts",
        "default": "./dist/macros.cjs"
      },
      "import": {
        "types": "./dist/macros.d.mts",
        "default": "./dist/macros.mjs"
      }
    }
  },
  "keywords": [
    "react",
    "translation",
    "internationalization",
    "localization",
    "i18n"
  ]
}
