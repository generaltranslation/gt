{
  "name": "@generaltranslation/svelte-extractor",
  "version": "0.0.0",
  "description": "Svelte source code extraction and preprocessing for General Translation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "author": "General Translation, Inc.",
  "license": "MIT",
  "scripts": {
    "transpile": "tsdown",
    "build": "pnpm run transpile",
    "build:watch": "tsdown --watch",
    "build:clean": "sh ../../scripts/clean.sh && pnpm run build",
    "build:release": "pnpm run build:clean",
    "format": "oxfmt src",
    "release": "pnpm run build:clean && pnpm publish",
    "release:alpha": "pnpm run build:clean && pnpm publish --tag alpha",
    "release:beta": "pnpm run build:clean && pnpm publish --tag beta",
    "release:latest": "pnpm run build:clean && pnpm publish --tag latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generaltranslation/gt.git"
  },
  "keywords": [
    "svelte",
    "extraction",
    "preprocess",
    "translation",
    "i18n"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-react": "^7.29.7",
    "@generaltranslation/react-core": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.1.15",
    "react": "19.1.1",
    "svelte": "^5.57.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@generaltranslation/format": "workspace:*",
    "@generaltranslation/icu": "workspace:*",
    "fast-glob": "^3.3.3",
    "generaltranslation": "workspace:*",
    "magic-string": "^1.4.3"
  }
}
