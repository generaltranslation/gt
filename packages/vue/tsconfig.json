{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "sourceMap": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true
  },
  "include": [
    "components/**/*",
    "composables/**/*",
    "messages/**/*",
    "rendering/**/*",
    "runtime/**/*",
    "src/**/*",
    "types/**/*"
  ],
  "exclude": ["**/*.test.ts"],
  "references": [
    {
      "path": "../core"
    }
  ]
}
