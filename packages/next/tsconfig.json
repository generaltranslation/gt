{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    // Next aliases replace these self-referenced entries at build time;
    // typecheck them against their source fallbacks.
    "paths": {
      "gt-next/internal/_getLocale": ["./src/internal/_getLocale.ts"],
      "gt-next/internal/_getRegion": ["./src/internal/_getRegion.ts"]
    }
  },
  "include": ["src/**/*", "src/.ts"],
  "exclude": ["**/__tests__/**/*", "**/__mocks__/**/*"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../react"
    },
    {
      "path": "../i18n"
    }
  ]
}
