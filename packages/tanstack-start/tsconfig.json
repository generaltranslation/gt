{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES6",
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "Bundler",
    "sourceMap": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "composite": true,
    "paths": {
      "gt-tanstack-start/internal/_config": ["./src/internal/_config.ts"],
      "gt-tanstack-start/internal/_compat-config": [
        "./src/internal/_compat-config.ts"
      ],
      "gt-tanstack-start/internal/localeRouting": [
        "./src/internal/localeRouting.ts"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../supported-locales"
    },
    {
      "path": "../react"
    },
    {
      "path": "../i18n"
    },
    {
      "path": "../react-core"
    }
  ]
}
