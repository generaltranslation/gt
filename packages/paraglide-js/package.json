{
  "name": "@generaltranslation/paraglide-js",
  "version": "0.1.0",
  "description": "Paraglide JS integration for General Translation. Collects the source-code context of Paraglide message usages, as a CLI or a library, without changing Paraglide.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "paraglide-context": "./dist/src/compiler/cli/index.js"
  },
  "files": [
    "dist",
    "native/binding.d.cts"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./compiler": {
      "types": "./dist/src/compiler.d.ts",
      "default": "./dist/src/compiler.js"
    },
    "./native": {
      "types": "./native/binding.d.cts",
      "default": "./dist/native/binding.cjs"
    }
  },
  "author": "General Translation, Inc.",
  "license": "MIT",
  "scripts": {
    "transpile": "tsc -p tsconfig.build.json",
    "build": "pnpm run build:native && pnpm run transpile",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "build:clean": "sh ../../scripts/clean.sh && pnpm run build",
    "build:release": "pnpm run build:clean",
    "format": "oxfmt src __tests__ scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "build:native:debug": "node scripts/build-native.mjs --debug",
    "build:native:bindings": "pnpm --package=@napi-rs/cli@3.10.12 dlx napi build --platform --release --manifest-path native/Cargo.toml --output-dir native --js binding.cjs --dts binding.d.cts",
    "test:rust": "cargo test --manifest-path native/Cargo.toml --no-default-features --features mimalloc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generaltranslation/gt.git",
    "directory": "packages/paraglide-js"
  },
  "keywords": [
    "paraglide",
    "inlang",
    "translation",
    "i18n",
    "cli"
  ],
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@oxc-project/types": "^0.157.0",
    "globby": "^16.2.0",
    "oxc-parser": "^0.157.0",
    "oxc-resolver": "^11.24.2",
    "package-manager-detector": "^1.8.0",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.1.0",
    "@types/node": "catalog:",
    "@types/picomatch": "^4.0.3",
    "paraglide-js-1": "npm:@inlang/paraglide-js@^1.11.8",
    "paraglide-js-2": "npm:@inlang/paraglide-js@^2.29.3",
    "typescript": "catalog:",
    "vite": "^8.3.1",
    "vite5": "npm:vite@^5.4.21",
    "vite6": "npm:vite@^6.4.5",
    "vite7": "npm:vite@^7.3.7",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "paraglide-context",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  }
}
