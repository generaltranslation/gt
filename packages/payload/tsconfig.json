{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    "declarationMap": false,
    "sourceMap": true,
    // Stays on bundler because next has no exports map for NodeNext. tsc emits
    // per-file ESM .d.ts, so relative imports need explicit .js extensions;
    // the attw check in the build fails if one is missing.
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts", "**/__tests__/**"]
}
