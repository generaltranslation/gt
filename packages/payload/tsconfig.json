{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    "declarationMap": false,
    "sourceMap": true,
    // Stays on bundler because next has no exports map for NodeNext. tsdown
    // emits the declarations and adds .js to relative specifiers.
    "moduleResolution": "bundler",
    // Payload's packages import React without depending on its types, so
    // under pnpm their components would otherwise type as any. Point them
    // at this package's React types so their props are checked.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts", "**/__tests__/**"]
}
