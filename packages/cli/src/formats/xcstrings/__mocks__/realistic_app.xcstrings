    "account.deleteAccount.confirm" : {
      "comment" : "Destructive confirmation alert.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي حذف حسابك إلى إزالة جميع المهام والمشاريع. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dein Konto löschst, werden alle Aufgaben und Projekte entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account removes every task and project. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar tu cuenta se borran todas las tareas y proyectos. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de votre compte efface toutes les tâches et tous les projets. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除すると、すべてのタスクとプロジェクトが削除されます。この操作は取り消せません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление учётной записи приведёт к удалению всех задач и проектов. Это действие нельзя отменить."
          }
        }
      }
    },
