    "You will no longer be able to approve login requests from this device." : {
      "comment" : "Body of the device removal confirmation dialog.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تتمكن بعد الآن من الموافقة على طلبات تسجيل الدخول من هذا الجهاز."
