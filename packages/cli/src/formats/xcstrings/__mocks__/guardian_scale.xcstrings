    "This device appears to be jailbroken. Guardian cannot protect your account on a compromised device." : {
      "comment" : "Jailbreak detection warning.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو أن هذا الجهاز قد خضع لكسر الحماية. لا يستطيع Guardian حماية حسابك على جهاز مخترق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изглежда, че на това устройство са премахнати ограниченията. Guardian не може да защити профила ви на компрометирано устройство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení se zdá být po jailbreaku. Guardian nemůže chránit váš účet na napadeném zařízení."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae’n ymddangos bod cyfyngiadau’r ddyfais hon wedi’u tynnu. Ni all Guardian ddiogelu eich cyfrif ar ddyfais sydd wedi’i pheryglu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed ser ud til at være jailbreaket. Guardian kan ikke beskytte din konto på en kompromitteret enhed."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή φαίνεται να έχει υποστεί άρση περιορισμών. Το Guardian δεν μπορεί να προστατεύσει τον λογαριασμό σας σε παραβιασμένη συσκευή."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo parece estar liberado. Guardian no puede proteger tu cuenta en un dispositivo comprometido."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Näib, et sellel seadmel on tootjapiirangud eemaldatud. Guardian ei saa kaitsta teie kontot ohustatud seadmes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "به نظر می‌رسد این دستگاه جیلبریک شده است. Guardian نمی‌تواند از حساب شما روی دستگاه دستکاری‌شده محافظت کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä laite vaikuttaa murretulta. Guardian ei voi suojata tiliäsi vaarantuneella laitteella."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mukhang na-jailbreak ang device na ito. Hindi maprotektahan ng Guardian ang iyong account sa isang na-compromise na device."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil semble avoir été débridé. Guardian ne peut pas protéger votre compte sur un appareil compromis."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dealraíonn sé gur baineadh na srianta den ghléas seo. Ní féidir le Guardian do chuntas a chosaint ar ghléas atá i mbaol."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נראה שבמכשיר זה בוצעה פריצה. Guardian אינו יכול להגן על חשבונך במכשיר שנפרץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऐसा लगता है कि यह डिवाइस जेलब्रेक किया गया है। Guardian किसी छेड़छाड़ किए गए डिवाइस पर आपके खाते की सुरक्षा नहीं कर सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čini se da je ovaj uređaj podvrgnut jailbreaku. Guardian ne može zaštititi vaš račun na ugroženom uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úgy tűnik, hogy ezen az eszközön feloldották a gyári korlátozásokat. A Guardian nem tudja megvédeni a fiókját feltört eszközön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini tampaknya sudah di-jailbreak. Guardian tidak dapat melindungi akun Anda di perangkat yang disusupi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Þetta tæki virðist hafa verið brotið upp. Guardian getur ekki verndað reikninginn þinn á tæki sem átt hefur verið við."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは脱獄されている可能性があります。改ざんされたデバイスではGuardianがアカウントを保護できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 탈옥된 것으로 보입니다. 손상된 기기에서는 Guardian이 계정을 보호할 수 없습니다."
