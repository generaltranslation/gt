{
  "name": "gtx-cli",
  "version": "3.0.0-samsara.1",
  "description": "CLI tool for AI-powered i18n (wrapper for gt)",
  "main": "dist/index.js",
  "bin": "bin/main.js",
  "files": [
    "bin",
    "dist",
    "binaries",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "transpile": "tsdown",
    "build": "pnpm run transpile",
    "build:clean": "sh ../../scripts/clean.sh && pnpm bin:restore && rm -rf binaries && pnpm run build",
    "build:release": "pnpm run build:clean",
    "build:bin": "pnpm run build && bash scripts/build-exe.sh all",
    "build:bin:clean": "sh ../../scripts/clean.sh && rm -rf binaries && pnpm run build:bin",
    "build:bin:release": "pnpm run build:bin:clean",
    "build:bin:darwin-x64": "bash scripts/build-exe.sh darwin-x64",
    "build:bin:darwin-arm64": "bash scripts/build-exe.sh darwin-arm64",
    "build:bin:linux-x64": "bash scripts/build-exe.sh linux-x64",
    "build:bin:linux-arm64": "bash scripts/build-exe.sh linux-arm64",
    "build:bin:windows-x64": "bash scripts/build-exe.sh windows-x64",
    "test": "vitest run --config=./vitest.config.ts",
    "test:watch": "vitest --config=./vitest.config.ts",
    "release": "pnpm run release:normal && pnpm run release:bin",
    "release:normal": "pnpm run build:clean && pnpm publish",
    "release:bin": "pnpm run bin:prep && pnpm run build:bin:clean && pnpm publish --tag bin --no-git-checks && pnpm run bin:restore && pnpm run build:clean",
    "release:alpha": "pnpm run build:clean && pnpm publish --tag alpha",
    "release:beta": "pnpm run build:clean && pnpm publish --tag beta",
    "release:latest": "pnpm run build:clean && pnpm publish --tag latest",
    "bin:prep": "node scripts/prepare-binary-release.js",
    "bin:restore": "node scripts/restore-package-json.js",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin/bin-entry": {
      "types": "./dist/bin/bin-entry.d.ts",
      "import": "./dist/bin/bin-entry.js"
    },
    "./bin/bin-main": {
      "types": "./dist/bin/bin-main.d.ts",
      "import": "./dist/bin/bin-main.js"
    },
    "./config/generateSettings": {
      "types": "./dist/config/generateSettings.d.ts",
      "import": "./dist/config/generateSettings.js"
    },
    "./config/resolveConfig": {
      "types": "./dist/config/resolveConfig.d.ts",
      "import": "./dist/config/resolveConfig.js"
    },
    "./fs/config/setupConfig": {
      "types": "./dist/fs/config/setupConfig.d.ts",
      "import": "./dist/fs/config/setupConfig.js"
    },
    "./fs/matchFiles": {
      "types": "./dist/fs/matchFiles.d.ts",
      "import": "./dist/fs/matchFiles.js"
    },
    "./functions": {
      "types": "./dist/functions.d.ts",
      "import": "./dist/functions.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./next/parse/handleInitGT": {
      "types": "./dist/next/parse/handleInitGT.d.ts",
      "import": "./dist/next/parse/handleInitGT.js"
    },
    "./next/parse/wrapContent": {
      "types": "./dist/next/parse/wrapContent.d.ts",
      "import": "./dist/next/parse/wrapContent.js"
    },
    "./react/parse/wrapContent": {
      "types": "./dist/react/parse/wrapContent.d.ts",
      "import": "./dist/react/parse/wrapContent.js"
    },
    "./types/index": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./utils/installPackage": {
      "types": "./dist/utils/installPackage.d.ts",
      "import": "./dist/utils/installPackage.js"
    },
    "./utils/packageInfo": {
      "types": "./dist/utils/packageInfo.d.ts",
      "import": "./dist/utils/packageInfo.js"
    },
    "./utils/packageJson": {
      "types": "./dist/utils/packageJson.d.ts",
      "import": "./dist/utils/packageJson.js"
    },
    "./utils/packageManager": {
      "types": "./dist/utils/packageManager.d.ts",
      "import": "./dist/utils/packageManager.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generaltranslation/gt.git"
  },
  "keywords": [
    "i18n",
    "l10n",
    "translation",
    "internationalization",
    "localization",
    "cli"
  ],
  "author": "General Translation, Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/generaltranslation/gt/issues"
  },
  "homepage": "https://generaltranslation.com/",
  "dependencies": {
    "gt": "workspace:*",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
