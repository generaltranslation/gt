{
  "name": "@generaltranslation/api",
  "version": "0.5.5",
  "description": "Generated TypeScript SDK for the General Translation API",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "spec/openapi.json",
    "CHANGELOG.md"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./spec/openapi.json": "./spec/openapi.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:clean": "sh ../../scripts/clean.sh && pnpm run build",
    "build:release": "pnpm run build:clean",
    "codegen": "openapi-ts && biome format --write src/generated spec/openapi.json",
    "format": "biome format src openapi-ts.config.ts tsdown.config.mts package.json tsconfig.json spec/openapi.json",
    "lint": "biome lint src",
    "test": "vitest run --typecheck",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generaltranslation/gt.git"
  },
  "author": "General Translation, Inc.",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@hey-api/openapi-ts": "0.88.0",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
