    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@generaltranslation/compiler": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "gt": "workspace:*",
    "typescript": "^5",
    "vite": "^8.0.16",
    "vitest": "catalog:"
  }
}
