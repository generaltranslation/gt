{
  "name": "gt-test-vite-react-twins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4180 --strictPort",
    "generate": "gt --skip-version-check generate --config gt.config.json && oxfmt src/_gt",
    "test": "vitest run",
    "lint": "oxlint --config ../../../examples/.oxlintrc.react.json .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gt-react": "workspace:*",
