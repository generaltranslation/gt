{
  "name": "gt-test-sveltekit-3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --host 127.0.0.1 --port 5183 --strictPort",
    "generate": "gt --skip-version-check generate --config gt.config.json",
    "preview": "vite preview --host 127.0.0.1 --port 5183 --strictPort",
    "test:e2e:serve": "pnpm run build && pnpm run preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "gt-svelte": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "gt": "workspace:*",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.3.5"
  }
}
