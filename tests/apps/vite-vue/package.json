{
  "name": "gt-test-vite-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run generate && pnpm run typecheck && vite build",
    "dev": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "generate": "gt --skip-version-check generate --config gt.config.json",
    "lint": "oxlint --config ../../../.oxlintrc.json .",
    "preview": "vite preview --host 127.0.0.1 --port 5179 --strictPort",
    "test:e2e:serve": "pnpm run build && pnpm run preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gt-vue": "workspace:*",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "gt": "workspace:*",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  }
}
