{
  "defaultLocale": "en",
  "locales": ["fr"],
  "files": {
    "json": {
      "include": ["content/[locale]/*.json"]
    },
    "gt": {
      "parsingFlags": {
        "includeSourceCodeContext": true,
        "devHotReload": { "strings": true, "jsx": false },
        "viteConfigPath": "vite.config.ts",
        "vueCompilerOptions": {
          "whitespace": "preserve",
          "delimiters": ["[[", "]]"]
        }
      }
    }
  }
}
