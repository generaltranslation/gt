{
  "name": "gt-test-sveltekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --host 127.0.0.1 --port 5181 --strictPort",
    "generate": "gt --skip-version-check generate --config gt.config.json",
    "preview": "vite preview --host 127.0.0.1 --port 5181 --strictPort",
    "test:e2e:serve": "pnpm run build && pnpm run preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "gt-svelte": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "gt": "workspace:*",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "catalog:",
    "vite": "^7.3.1"
  }
}
