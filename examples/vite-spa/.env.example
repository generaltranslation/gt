# Copy this file to .env.local and fill in your credentials.
# Get them at https://dash.generaltranslation.com/signup or by running `npx gt init`.
# gtReact() in vite.config.ts exposes GT_API_KEY to the browser during `vite dev`
# only; `vite build` output never contains it. Use a key with only the
# project:translations:generate permission. Never expose keys with management or file permissions.
GT_PROJECT_ID=
GT_API_KEY=
