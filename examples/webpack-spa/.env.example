# Copy this file to .env.local and fill in your credentials to enable
# dev-mode translation hot reload. Both values are optional: without them the
# app still runs and switches between the languages that have files in src/_gt.
#
# Get these by running `npx gt init` or from https://dash.generaltranslation.com
# Only expose a key with project:translations:generate permission in the browser.
# Never expose keys with management or file permissions.

REACT_APP_GT_PROJECT_ID=""
REACT_APP_GT_DEV_API_KEY=""
