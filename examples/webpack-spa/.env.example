# Copy this file to .env.local and fill in your credentials to enable
# dev-mode translation hot reload. Both values are optional: without them the
# app still runs and switches between the languages that have files in src/_gt.
#
# This example is already configured, so skip `npx gt init`. Sign in with
# `npx gt login`, then create a generate-only runtime key for your project:
#   npx gt api-key create --project-id <your-project-id> --name "Local development" --permission project:translations:generate
# Older copies of this file used GT_PROJECT_ID and GT_DEV_API_KEY; rename them
# to the REACT_APP_ names below, which webpack.config.mjs reads.
# Never expose keys with management or file permissions in the browser.

REACT_APP_GT_PROJECT_ID=""
REACT_APP_GT_DEV_API_KEY=""
